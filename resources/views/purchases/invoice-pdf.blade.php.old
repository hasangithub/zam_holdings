                        @php
                        $invoiceLogo = collect(['png', 'jpg', 'jpeg'])
                        ->map(fn ($ext) => public_path("images/invoice/logo.{$ext}"))
                        ->first(fn ($path) => file_exists($path));
                        @endphp

                        @if ($invoiceLogo)
                        <img
                            src="{{ public_path('images/invoice/' . basename($invoiceLogo)) }}"
                            alt="Invoice Logo"
